# Sao chép thành .env.local rồi chỉnh theo máy
# Base path của API (Vite proxy /api sang http://localhost:8080 khi dev).
# Server hiện tại dùng /api/auth (chưa có /v1) → đặt /api khi gọi backend thật.
VITE_API_BASE_URL=/api/v1
# true: dùng MSW trả dữ liệu mẫu, không cần backend
VITE_USE_MOCKS=true
# Client ID (OAuth, loại Web application) của Google Identity Services; để trống thì nút Google báo chưa cấu hình.
# Trong Google Cloud Console, thêm http://localhost:5173 (và domain thật) vào "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=
# Địa chỉ WebSocket (STOMP) của backend. Vercel không chuyển tiếp WebSocket nên production phải trỏ thẳng tới BE.
# Server hiện tại dùng endpoint SockJS /ws-chat → WebSocket thuần ở /ws-chat/websocket
VITE_WS_URL=ws://localhost:8080/ws-chat/websocket
