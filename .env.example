# Sao chép thành .env.local rồi chỉnh theo máy
# Base path của API (Vite proxy /api sang http://localhost:8080 khi dev)
VITE_API_BASE_URL=/api/v1
# true: dùng MSW trả dữ liệu mẫu, không cần backend
VITE_USE_MOCKS=true
# Client ID của Google Identity Services (để trống thì nút Google báo chưa cấu hình)
VITE_GOOGLE_CLIENT_ID=
